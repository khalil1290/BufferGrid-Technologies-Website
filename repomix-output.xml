function Contact() {
  const [status, setStatus] = useState<"idle" | "success" | "error">("idle");
  const [isSubmitting, setIsSubmitting] = useState(false);

  const [form, setForm] = useState({
    name: "",
    email: "",
    company: "",
    service: "Website Development",
    budget: "",
    message: "",
  });

  const update = (
    e: React.ChangeEvent<
      HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
    >,
  ) => {
    setForm((previous) => ({
      ...previous,
      [e.target.name]: e.target.value,
    }));
    setStatus("idle");
  };

  const submit = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();

    setIsSubmitting(true);
    setStatus("idle");

    try {
      const response = await fetch("https://formspree.io/f/mdegalwa", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({
          ...form,
          _subject: `New project enquiry - ${form.name}`,
        }),
      });

      if (!response.ok) {
        throw new Error("Form submission failed");
      }

      setStatus("success");

      setForm({
        name: "",
        email: "",
        company: "",
        service: "Website Development",
        budget: "",
        message: "",
      });
    } catch (error) {
      console.error("Form submission error:", error);
      setStatus("error");
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <>
      <PageIntro
        eyebrow="LET'S TALK"
        title={
          <>
            Have a project?
            <br />
            <em>Let's make it happen.</em>
          </>
        }
        text="Tell us a little about what you're working on. We'll review your enquiry and get back to you to discuss the next steps."
      />

      <section className="section contact-page">
        <div className="container contact-layout">
          <Reveal className="contact-aside">
            <span className="eyebrow">START A CONVERSATION</span>
            <h2>
              Tell us what
              <br />
              you have in mind.
            </h2>
            <p>
              Whether you need a new website, want to improve an existing one or
              have an idea for a custom web solution, we're ready to hear about
              it.
            </p>

            <div className="contact-detail">
              <span>EMAIL</span>
              <strong>hello@buffergrid.tech</strong>
            </div>

            <div className="contact-detail">
              <span>AVAILABILITY</span>
              <strong>Remote projects</strong>
            </div>
          </Reveal>

          <Reveal as="section" delay={150}>
            <form className="contact-form" onSubmit={submit}>
              <div className="form-heading">
                <h3>Project enquiry</h3>
                <p>Fields marked * are required.</p>
              </div>

              <div className="form-grid">
                <label>
                  Your name *
                  <input
                    required
                    name="name"
                    value={form.name}
                    onChange={update}
                    placeholder="Full name"
                  />
                </label>

                <label>
                  Email address *
                  <input
                    required
                    type="email"
                    name="email"
                    value={form.email}
                    onChange={update}
                    placeholder="you@company.com"
                  />
                </label>

                <label>
                  Company / business
                  <input
                    name="company"
                    value={form.company}
                    onChange={update}
                    placeholder="Business name"
                  />
                </label>

                <label>
                  What do you need?
                  <select name="service" value={form.service} onChange={update}>
                    <option>Website Development</option>
                    <option>E-commerce Solutions</option>
                    <option>Custom Web Application</option>
                    <option>Website Improvement & Support</option>
                    <option>Integrations & Functionality</option>
                    <option>Not sure yet</option>
                  </select>
                </label>

                <label className="full-field">
                  Estimated budget (optional)
                  <input
                    name="budget"
                    value={form.budget}
                    onChange={update}
                    placeholder="Your budget range and currency"
                  />
                </label>

                <label className="full-field">
                  Tell us about your project *
                  <textarea
                    required
                    rows={5}
                    name="message"
                    value={form.message}
                    onChange={update}
                    placeholder="What are you looking to build? What problem should it solve?"
                  />
                </label>
              </div>

              <button
                className="btn btn-primary submit-btn"
                type="submit"
                disabled={isSubmitting}
              >
                {isSubmitting ? "Sending..." : "Send enquiry"}
                <Send size={17} />
              </button>

              {status === "success" && (
                <p className="form-note" role="status">
                  Thank you! Your enquiry has been sent successfully. We'll be
                  in touch soon.
                </p>
              )}

              {status === "error" && (
                <p className="form-note" role="alert">
                  We couldn't send your enquiry. Please try again or contact us
                  directly by email.
                </p>
              )}

              <p className="form-disclaimer">
                Your information will be used to respond to your project
                enquiry.
              </p>
            </form>
          </Reveal>
        </div>
      </section>
    </>
  );
}

function NotFound() {
  return (
    <div className="container not-found">
      <span className="eyebrow">404</span>
      <h1>This page doesn't exist.</h1>
      <Link to="/" className="btn btn-dark">
        Back to home
      </Link>
    </div>
  );
}

const seoPages: Record<string, { title: string; description: string }> = {
  "/": {
    title: "Website Development Agency | BufferGrid Technologies",
    description:
      "BufferGrid Technologies builds professional websites and online stores, redesigns existing websites and provides web solutions for businesses in Nigeria and worldwide.",
  },

  "/services": {
    title: "Website Development, Redesign & Maintenance | BufferGrid",
    description:
      "Explore website development, e-commerce, website redesign, maintenance and custom web application services for businesses in Nigeria and internationally.",
  },

  "/work": {
    title: "Our Website Development Projects | BufferGrid Technologies",
    description:
      "Explore websites and digital projects built by BufferGrid Technologies for businesses, including corporate websites and e-commerce experiences.",
  },

  "/about": {
    title: "About BufferGrid Technologies | Our Approach",
    description:
      "Meet BufferGrid Technologies, a web development agency helping businesses worldwide build and improve their digital presence.",
  },

  "/contact": {
    title: "Contact BufferGrid Technologies | Start a Project",
    description:
      "Looking for professional website development, redesign or maintenance? Contact BufferGrid Technologies to discuss your next project.",
  },
};

function RouteSEO() {
  const location = useLocation();
  const pathname = location.pathname;
  const projectSlug = pathname.split("/")[2];

  let page = seoPages[pathname];

  if (pathname.startsWith("/work/") && projectSlug) {
    const project = projects.find((item) => item.slug === projectSlug);

    if (project) {
      page = {
        title: `${project.name} Website Project | BufferGrid Technologies`,
        description: project.summary,
      };
    } else {
      page = {
        title: "Project Not Found | BufferGrid Technologies",
        description:
          "The requested project could not be found. Explore other projects by BufferGrid Technologies.",
      };
    }
  }

  if (!page) {
    page = {
      title: "Page Not Found | BufferGrid Technologies",
      description:
        "The page you're looking for could not be found. Visit BufferGrid Technologies to explore our services and projects.",
    };
  }

  return (
    <SEO title={page.title} description={page.description} path={pathname} />
  );
}

export default function App() {
  const location = useLocation();

  return (
    <>
      <RouteSEO />
      <Header />

      <main key={location.pathname} className="page-fade">
        <Routes location={location}>
          <Route path="/" element={<Home />} />
          <Route path="/services" element={<Services />} />
          <Route path="/work" element={<Work />} />
          <Route path="/work/:slug" element={<ProjectDetail />} />
          <Route path="/about" element={<About />} />
          <Route path="/contact" element={<Contact />} />
          <Route path="*" element={<NotFound />} />
        </Routes>
      </main>

      <Footer />
    </>
  );
}
