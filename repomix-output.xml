<file path="src/motion.css">
/* ==========================================
   BUFFERGRID MOTION & POLISH LAYER
   Import AFTER styles.css (see main.tsx).
   ========================================== */

/* ---------- Keyframes ---------- */
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(32px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes pagein {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes orbit-a {
  from {
    transform: rotate(-24deg);
  }
  to {
    transform: rotate(336deg);
  }
}
@keyframes orbit-b {
  from {
    transform: rotate(38deg);
  }
  to {
    transform: rotate(-322deg);
  }
}
@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12px);
  }
}
@keyframes drift {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-8px) rotate(-0.4deg);
  }
}
@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(0, 168, 117, 0.45);
  }
  100% {
    box-shadow: 0 0 0 12px rgba(0, 168, 117, 0);
  }
}
@keyframes breathe {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.12);
    opacity: 1;
  }
}
@keyframes glow-drift {
  from {
    transform: translate(0, 0) scale(1);
  }
  to {
    transform: translate(-90px, 50px) scale(1.18);
  }
}
@keyframes marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

/* ---------- Page transition ---------- */
.page-fade {
  animation: pagein 0.45s ease both;
}

/* ---------- Scroll reveal ---------- */
.reveal {
  opacity: 0;
}
.reveal.in {
  opacity: 1;
  animation: rise 0.85s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  animation-delay: var(--d, 0ms);
}

/* ---------- Hero entrance ---------- */
.rise {
  opacity: 0;
  animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
}
.hero h1 .rise {
  display: block;
}

/* Inner page intros */
.page-intro .container > *,
.detail-hero .container > * {
  animation: rise 0.85s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
}
.page-intro .container > :nth-child(2),
.detail-hero .container > :nth-child(2) {
  animation-delay: 0.1s;
}
.page-intro .container > :nth-child(3),
.detail-hero .container > :nth-child(3) {
  animation-delay: 0.2s;
}
.detail-hero .container > :nth-child(4) {
  animation-delay: 0.3s;
}
.detail-hero .container > :nth-child(5) {
  animation-delay: 0.4s;
}

/* ---------- Hero ambient motion ---------- */
.pulse-dot {
  animation: pulse 2s ease-out infinite;
}
.orbit-one {
  animation: orbit-a 34s linear infinite;
}
.orbit-two {
  animation: orbit-b 44s linear infinite;
}
.float-card {
  animation: float 6s ease-in-out infinite;
}
.card-stack {
  animation-delay: -2s;
}
.card-zap {
  animation-delay: -4s;
}

.hero-glow {
  position: absolute;
  width: 440px;
  height: 440px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 168, 117, 0.24), transparent 65%);
  filter: blur(30px);
  animation: breathe 8s ease-in-out infinite;
}

/* ---------- Hero browser showcase ---------- */
.browser {
  position: relative;
  z-index: 2;
  width: min(440px, 92%);
  background: #fff;
  border: 1px solid #e3e8ef;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 30px 70px rgba(11, 31, 68, 0.18);
  animation: drift 9s ease-in-out infinite;
}
.browser-bar {
  height: 34px;
  background: #f1f4f8;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 12px;
  border-bottom: 1px solid #e6ebf1;
}
.browser-bar i {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #d5dce6;
